# ─────────────────────────────────────────────────────────────────────────────
# Faísca Auth Starter: environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Every variable exposed to the browser MUST start with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your brand ──────────────────────────────────────────────────────────────
# While the name or logo is missing, the header shows a transparent placeholder
# (click it in the app for a quick guide).
#
# App name shown in the header, login screen and browser tab.
VITE_APP_NAME=Voto Informado

# Logo: EITHER drop a file named logo.svg/.png/.webp/.jpg into src/brand/
# (picked up automatically), OR set a link here (takes priority over the folder).
# Accepts an absolute URL or a path under /public, e.g. /my-logo.svg
VITE_APP_LOGO_URL=

# Small "feito com Faísca" badge in the bottom corner. Off here: the footer of
# PublicLayout carries the equivalent credit required by the LICENSE (name, both
# marks and the repository link).
VITE_SHOW_POWERED_BY=false

# ── Election data ───────────────────────────────────────────────────────────
# Where the public JSON (/api/...), photos (/fotos) and plans (/propostas) live.
# Empty = same origin: in dev Vite proxies them to the FastAPI backend (port 8000);
# in a static deploy they are files exported by `python -m app.export`.
VITE_DATA_URL=

# Where photos (/fotos) and government plans (/propostas) live. Empty = same as VITE_DATA_URL.
# With the API on Cloud Run, point this to the static host, e.g. https://professorbossini.github.io/voto-informado
VITE_ASSETS_URL=

# Public address of the site, used in shared links ("Compartilhar"). Empty = the page's own origin.
# Only the mobile apps need it (they run from a local origin): see .env.app.
VITE_SITE_URL=

# Base path when the site is hosted under a sub-folder (GitHub Pages project sites),
# e.g. /voto-informado/ . Leave empty for the domain root.
VITE_BASE_PATH=

# Polls tab (Pesquisas). PENDING: keep false until every TSE registration number is
# checked at https://pesqele-divulgacao.tse.jus.br (backend also needs PESQUISAS_ATIVAS=1).
VITE_ENABLE_PESQUISAS=false

# Sign-in is OFF: the whole site is public. Set to true to show the "Entrar" button
# and the /login routes (Google sign-in is ready via the adapters below).
VITE_ENABLE_LOGIN=false

# Which auth adapter to use:
#   mock     → fake Google login, no credentials needed (great for UI work)
#   firebase → Firebase Authentication (recommended: sessions persist and refresh)
#   backend  → Google Identity Services + YOUR own API (see docs/backend-contract.md)
VITE_AUTH_PROVIDER=mock

# Show e-mail/password login, sign up and password reset (if the adapter supports it).
VITE_ENABLE_EMAIL_PASSWORD=true

# Base URL of your API. The HTTP client in src/api attaches the auth token to every call.
# Leave empty to use the built-in demo data.
# Example with the reference backend: http://localhost:3333/api
VITE_API_URL=

# ── Firebase (VITE_AUTH_PROVIDER=firebase) ──────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Google Identity Services (VITE_AUTH_PROVIDER=backend) ───────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web)
VITE_GOOGLE_CLIENT_ID=
