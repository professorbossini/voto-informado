# Copy to .env and fill in. Never commit .env.
PORT=3333

# Comma-separated list of front-end origins allowed to call this API with cookies.
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud console → Credentials → OAuth client ID (Web application).
# Same client ID as VITE_GOOGLE_CLIENT_ID in the front-end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional: also accept Firebase ID tokens (front-end with VITE_AUTH_PROVIDER=firebase).
FIREBASE_PROJECT_ID=
