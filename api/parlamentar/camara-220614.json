ara quem mora longe); compare preferencialmente parlamentares do mesmo estado."}],"limite_mensal":{"valor_mensal":47267.41,"vigencia":"valor atual publicado em 2026-10-02","fonte_url":"https://www.camara.leg.br/transparencia/gastos-parlamentares"}}